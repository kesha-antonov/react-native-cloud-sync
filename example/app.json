{
  "expo": {
    "name": "Cloud Storage Example",
    "slug": "react-native-cloud-sync-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.reactnativecloudsync"
    },
    "android": {
      "package": "com.example.reactnativecloudsync"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      [
        "@kesha-antonov/react-native-cloud-sync",
        {
          "containerIdentifier": "iCloud.com.example.reactnativecloudsync"
        }
      ]
    ]
  }
}
